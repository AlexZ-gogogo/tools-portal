# Copy settings to the process environment or App Service Configuration.
# This file is documentation; the application does not automatically load .env.
PORT=8080
NODE_ENV=production
PORTAL_ORIGIN=https://tools-portal-site.azurewebsites.net

# Set a password hash generated by `npm run admin:hash` and a random 32+ character secret.
# Keep both out of Git and deployment archives. Without auth configured, uploads stay disabled.
PORTAL_ADMIN_PASSWORD_HASH=
PORTAL_SESSION_SECRET=

# Storage: local for one-process development; blob for production/multiple instances.
PORTAL_STORAGE=blob
PORTAL_BLOB_ACCOUNT_URL=
PORTAL_BLOB_CONTAINER=tools-portal
# Optional user-assigned managed identity client ID.
AZURE_CLIENT_ID=

# Alternatively use Entra + App Service Easy Auth, with anonymous reads allowed.
# Explicitly configure one tenant and an object ID allowlist or a named admin role.
PORTAL_TRUST_APP_SERVICE_AUTH=false
PORTAL_ADMIN_TENANT_ID=
PORTAL_ADMIN_OBJECT_IDS=
PORTAL_ADMIN_ROLE=PortalAdmin

# Optional for local storage outside the code directory.
PORTAL_DATA_DIR=
